# Luca Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.

# === LLM Provider ===
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=phi3:mini

# === Optional API keys (for future cloud fallback) ===
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# === Debug ===
# LUCA_DEBUG=false
# LUCA_LOG_LEVEL=INFO
